// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Enums
//

enum UserRole {
  admin
  user
}

enum OrderStatus {
  AWAITING_DEPOSIT
  DEPOSIT_CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum AskStatus {
  WAITING
  ANSWERED
  CLOSED
}

//
// Models
//

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     UserRole @default(user)

  displayName String?
  phone       String?

  // 기본 배송지 (프론트 호환: defaultZip/defaultAddress1/defaultAddress2)
  defaultZip      String?
  defaultAddress1 String?
  defaultAddress2 String?

  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  orders   Order[]
  asks     Ask[]
  replies  AskReply[]
  sessions RefreshSession[]

  @@index([role])
}

model RefreshSession {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id           Int     @id @default(autoincrement())
  categorySlug String
  name         String
  price        Int?
  description  String?

  // md url + text fallback (프론트가 둘 다 씀)
  sizeGuideMdUrl   String?
  productInfoMdUrl String?
  lookMdUrl        String?

  sizeGuideText   String?
  productInfoText String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)

  images   ProductImage[]
  options  ProductOption[]
  variants ProductVariant[]

  orderItems OrderItem[]

  @@index([categorySlug])
  @@index([isActive])
  @@index([createdAt])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int

  // "size" | "color" 등
  groupKey String
  label    String
  value    String

  sku        String?
  priceDelta Int?     @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeVariants  ProductVariant[] @relation("SizeOption")
  colorVariants ProductVariant[] @relation("ColorOption")

  @@unique([productId, groupKey, value])
  @@index([productId, groupKey])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  sizeOptionId  Int?
  colorOptionId Int?

  stock      Int   @default(0)
  sku        String?
  priceDelta Int?  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeOption  ProductOption? @relation("SizeOption", fields: [sizeOptionId], references: [id], onDelete: SetNull)
  colorOption ProductOption? @relation("ColorOption", fields: [colorOptionId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@unique([productId, sizeOptionId, colorOptionId])
  @@index([productId])
  @@index([sizeOptionId])
  @@index([colorOptionId])
}

model Order {
  // 문자열 주문번호 (makeId("O") 등)
  id String @id

  userId Int
  status OrderStatus @default(AWAITING_DEPOSIT)

  createdAt DateTime @default(now())
  // ✅ H=1: expiresAt 필수
  expiresAt DateTime

  shippedAt   DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?

  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  depositor     String?

  receiverName  String
  receiverPhone String
  receiverEmail String?

  zip      String
  address1 String
  address2 String
  memo     String?

  carrier    String?
  trackingNo String?

  grandTotal Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  items      OrderItem[]
  return     Return?
  refundLogs RefundLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId Int
  variantId Int?

  qty   Int
  price Int

  // 주문 시점 스냅샷
  name         String
  thumbnailUrl String?
  optionSummary String?

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Return {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  status ReturnStatus @default(REQUESTED)

  reason String?
  memo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model RefundLog {
  id      String @id @default(cuid())
  orderId String

  amount Int
  memo   String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model SystemPolicy {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id String @id @default(cuid())
  title String
  body  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Ask {
  id String @id @default(cuid())

  userId Int
  title  String
  body   String

  status AskStatus @default(WAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user    User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  replies AskReply[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model AskReply {
  id String @id @default(cuid())

  askId  String
  userId Int?

  body    String
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  ask  Ask   @relation(fields: [askId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([askId])
  @@index([createdAt])
}